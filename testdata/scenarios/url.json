{"launch":{"argv":["sh","scripts/sandbox.sh","--seed","--","./bin/jot","--config","testdata/config-record.toml"],"cols":80,"rows":24,"env":{"LC_ALL":"ja_JP.UTF-8"}},
"steps":[
{"do":"wait_text","text":"Today 0","timeout_ms":10000},
{"do":"press","keys":["Tab"]},
{"do":"wait_text","text":"牛乳を買う"},
{"do":"press","keys":["o"]},
{"do":"wait_text","text":"メモにURLはありません"},
{"do":"press","keys":["n"]},
{"do":"wait_text","text":"メモ編集"},
{"do":"type","text":"店: https://example.com/shop?item=milk&q=$(id)"},
{"do":"press","keys":["Enter"]},
{"do":"type","text":"地図 https://maps.example.org/a;b`x` と javascript:alert(1)"},
{"do":"press","keys":["Enter"]},
{"do":"type","text":"file:///etc/passwd"},
{"do":"press","keys":["Ctrl+s"]},
{"do":"wait_text","text":"メモを保存しました"},
{"do":"press","keys":["o"]},
{"do":"wait_text","text":"開くURLを選択"},
{"do":"expect_text","text":"1 https://example.com/shop?item=milk&q=$(id)"},
{"do":"expect_text","text":"2 https://maps.example.org/a;b"},
{"do":"expect_text","text":"3 [ブロック] javascript:alert(1"},
{"do":"expect_text","text":"4 [ブロック] file:///etc/passwd"},
{"do":"capture","name":"picker"},
{"do":"press","keys":["3"]},
{"do":"wait_text","text":"開きません (安全でないURL)"},
{"do":"press","keys":["4"]},
{"do":"wait_text","text":"開きません (安全でないURL): file:"},
{"do":"press","keys":["1"]},
{"do":"wait_text","text":"開きました: https://example.com/shop?item=milk&q=$(id)"},
{"do":"press","keys":["o"]},
{"do":"press","keys":["j"]},
{"do":"press","keys":["Enter"]},
{"do":"wait_text","text":"開きました: https://maps.example.org/a;b"},
{"do":"press","keys":["q"]},
{"do":"wait_exit","exit_code":0},
{"do":"expect_file","path":"$HOME/opened.log","includes":["ARG:https://example.com/shop?item=milk&q=$(id)\nEND\n","ARG:https://maps.example.org/a;b\nEND\n"]}
]}
