{"do":"expect_text","text":"? ヘルプ  q 終了  space Today  a 追加  x 完了  tab 切替","row":23},
{"do":"press","keys":["?"]},
{"do":"wait_text","text":"Jot キー一覧"},
{"do":"expect_text","text":"space"},
{"do":"expect_text","text":"Todayに追加/解除"},
{"do":"expect_text","text":"K shift+up"},
{"do":"expect_text","text":"j down"},
{"do":"capture","name":"help"},
{"do":"press","keys":["Escape"]},
{"do":"wait_gone","text":"Jot キー一覧"},
{"do":"press","keys":["Tab"]},
{"do":"wait_text","text":"▸ home (1)"},
{"do":"expect_text","text":"›   ☐ 牛乳を買う","row":2},
{"do":"press","keys":["j"]},
{"do":"wait_text","text":"›   ☐ 定例ミーティングの議事録"},
