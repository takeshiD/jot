{"do":"wait_text","text":"›   ☐ 牛乳を買う"},
{"do":"press","keys":["G"]},
{"do":"wait_text","text":"›   ☐ Read the Bubble Tea docs"},
{"do":"press","keys":["e"]},
{"do":"wait_text","text":"タイトル:"},
{"do":"press","keys":["Escape"]},
{"do":"wait_text","text":"取り消しました"},
{"do":"press","keys":["D"]},
{"do":"wait_text","text":"削除しますか?"},
{"do":"press","keys":["n"]},
{"do":"wait_text","text":"削除を取り消しました"},
{"do":"expect_text","text":"Read the Bubble Tea docs"},
{"do":"press","keys":["D"]},
{"do":"press","keys":["y"]},
{"do":"wait_text","text":"削除しました: Read the Bubble Tea docs"},
{"do":"expect_no_text","text":"▸ (グループなし)"},
